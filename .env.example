# ---------------------------------------------------------------------------
# Architecture Agent configuration
#
# Copy to .env and fill in. Never commit .env.
# Every value below is optional; defaults live in architecture_agent.config.
# Nested settings use the "__" separator, e.g. ARCH_AGENT_LLM__MODEL.
# ---------------------------------------------------------------------------

# --- Observability -------------------------------------------------------
ARCH_AGENT_LOG_LEVEL=INFO
ARCH_AGENT_LOG_FORMAT=json
ARCH_AGENT_LOG_INCLUDE_STACKTRACES=false
ARCH_AGENT_SERVICE_NAME=architecture-agent

# --- LLM (required for the reasoning pipeline, Milestone 3) ---------------
ARCH_AGENT_LLM__PROVIDER=anthropic
ARCH_AGENT_LLM__MODEL=claude-sonnet-4-5
ARCH_AGENT_LLM__TEMPERATURE=0.2
ARCH_AGENT_LLM__MAX_TOKENS=8192
ARCH_AGENT_LLM__TIMEOUT_SECONDS=120
# Leave empty to read from the provider's standard environment variable.
# ARCH_AGENT_LLM__API_KEY=
# ARCH_AGENT_LLM__BASE_URL=

# --- Web research (Milestone 6) ------------------------------------------
ARCH_AGENT_SEARCH__PROVIDER=duckduckgo
ARCH_AGENT_SEARCH__MAX_RESULTS=5
ARCH_AGENT_SEARCH__TIMEOUT_SECONDS=20
ARCH_AGENT_SEARCH__REGION=wt-wt

# --- Caching -------------------------------------------------------------
ARCH_AGENT_CACHE__ENABLED=true
ARCH_AGENT_CACHE__SEARCH_TTL_SECONDS=3600
ARCH_AGENT_CACHE__KNOWLEDGE_TTL_SECONDS=86400
ARCH_AGENT_CACHE__PRICING_TTL_SECONDS=21600

# --- Knowledge layer (Milestone 7) ---------------------------------------
ARCH_AGENT_KNOWLEDGE__DIRECTORY=.knowledge
ARCH_AGENT_KNOWLEDGE__CHUNK_SIZE_TOKENS=512
ARCH_AGENT_KNOWLEDGE__CHUNK_OVERLAP_TOKENS=64
ARCH_AGENT_KNOWLEDGE__EMBEDDING_PROVIDER=local
ARCH_AGENT_KNOWLEDGE__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- MCP server (Milestone 2) --------------------------------------------
ARCH_AGENT_MCP__TRANSPORT=stdio
# ARCH_AGENT_MCP__HOST=127.0.0.1
# ARCH_AGENT_MCP__PORT=8000

# --- Security posture ----------------------------------------------------
# Comma-separated allowlist of domains the research layer may fetch.
ARCH_AGENT_SECURITY__ALLOWED_DOMAINS=
ARCH_AGENT_SECURITY__MAX_FETCHED_CHARACTERS=200000
ARCH_AGENT_SECURITY__REDACT_LOGS=true
